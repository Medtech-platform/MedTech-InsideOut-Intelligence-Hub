# ── Required ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Web search (pick one) ──────────────────────────────────────
SERP_API_KEY=                  # https://serpapi.com
BRAVE_SEARCH_API_KEY=          # https://api.search.brave.com

# ── Output ─────────────────────────────────────────────────────
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO

# ── Optional: vector store for evidence retrieval ──────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
