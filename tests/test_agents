# ────────────────────────────────────────────────────────────────
# Schema validation tests (no LLM required)
# ────────────────────────────────────────────────────────────────

class TestSchemas:
    def test_project_scope_valid(self, mock_scope):
        scope = ProjectScope(**mock_scope)
        assert scope.geography == ["Germany"]
        assert len(scope.key_competitors) == 3

    def test_market_size_defaults(self):
        ms = MarketSize(
            geography="Germany",
            base_year=2024,
            total_market_value_musd=210.0,
            serviceable_market_musd=50.0,
        )
        assert ms.competitor_shares == []
        assert ms.confidence == "medium"

    def test_opportunity_matrix_sorting(self):
        from schemas.opportunity import ScoredOpportunity, OpportunityMatrix
        opps = [
            ScoredOpportunity(
                bucket_id="OB01", name="A",
                attractiveness=8, ability_to_win=7, strategic_fit=8, speed_to_revenue=7,
                weighted_score=7.5, decision_call="Do now",
                recommended_move="Enter now", rationale="Strong fit",
            ),
            ScoredOpportunity(
                bucket_id="OB02", name="B",
                attractiveness=4, ability_to_win=4, strategic_fit=4, speed_to_revenue=4,
                weighted_score=4.0, decision_call="Low priority",
                recommended_move="Monitor", rationale="Weak",
            ),
        ]
        matrix = OpportunityMatrix(scored_opportunities=opps)
        assert matrix.scored_opportunities[0].weighted_score == 7.5


