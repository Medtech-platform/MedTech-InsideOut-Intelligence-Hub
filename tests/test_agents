class TestOrchestrator:
    def test_pipeline_runs_without_errors(self, tmp_path, mock_scope):
        """Smoke test: orchestrator runs market_landscape module with mocked agents."""
        from core.orchestrator import Orchestrator, AssessmentConfig

        config = AssessmentConfig(
            brief_text="Enter orthopedic robotics market in Germany.",
            geography=["Germany"],
            module="market_landscape",
            run_id="smoke",
        )

        orch = Orchestrator(config)
        orch.state._path = tmp_path / "state.json"

        # Patch all agents to return mocked outputs
        with patch("core.orchestrator.ScopeAgent") as MockScope, \
             patch("core.orchestrator.MarketDynamicsAgent") as MockDyn, \
             patch("core.orchestrator.MarketSizingAgent") as MockSize:

            for Mock in [MockScope, MockDyn, MockSize]:
                instance = Mock.return_value
                instance.execute.return_value = MagicMock()

            results = orch.run()
            assert isinstance(results, dict)
