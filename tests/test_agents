class TestScopeAgent:
    def test_run_returns_project_scope(self, mock_llm_client, tmp_path):
        from agents.scope_agent import ScopeAgent
        from core.state_manager import StateManager

        state = StateManager(run_id="test")
        state._path = tmp_path / "state.json"

        agent = ScopeAgent(llm=mock_llm_client, state=state)
        # Patch web search to return nothing
        agent.search = MagicMock()
        agent.search.search.return_value = []

        result = agent.execute({"brief_text": "Client wants to enter German orthopedic robotics market."})
        assert isinstance(result, ProjectScope)
        assert "Germany" in result.geography


class TestScoringAgent:
    def test_weighted_score_computed_correctly(self):
        from agents.scoring_agent import _decision_call
        assert _decision_call(8.0) == "Do now"
        assert _decision_call(7.0) == "Winnable"
        assert _decision_call(5.5) == "Plan"
        assert _decision_call(3.0) == "Low priority"


